rules_version = '2';

// VisionKart Admin - Firestore Rules
// App uses custom auth (Firestore admin + localStorage), not Firebase Auth,
// so request.auth is null. Allow read/write for admin app collections.
// For production: restrict with request.auth != null if you switch to Firebase Auth.

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{document=**} {
      allow read, write: if true;
    }

    match /categories/{document=**} {
      allow read, write: if true;
    }

    match /lensEnhancements/{document=**} {
      allow read, write: if true;
    }

    match /coupons/{document=**} {
      allow read, write: if true;
    }

    match /categoryDiscounts/{document=**} {
      allow read, write: if true;
    }

    match /admin/{document=**} {
      allow read, write: if true;
    }

    match /customers/{document=**} {
      allow read, write: if true;
    }

    match /orders/{document=**} {
      allow read, write: if true;
    }

    match /users/{document=**} {
      allow read, write: if true;
    }

    match /siteSettings/{document=**} {
      allow read, write: if true;
    }
  }
}
